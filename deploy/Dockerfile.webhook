FROM python:3.11-slim

WORKDIR /app

# 安装系统依赖（git 用于克隆仓库）
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY pyproject.toml ./
RUN pip install --no-cache-dir -e ".[webhook]"

# 复制源码
COPY src ./src

# 创建数据目录
RUN mkdir -p /app/data

# 暴露端口
EXPOSE 8080

# 启动 Webhook 服务
ENV HARNESS_DB=/app/data/harness.db
ENV WEBHOOK_HOST=0.0.0.0
ENV WEBHOOK_PORT=8080

CMD ["python", "scripts/run_webhook.py"]