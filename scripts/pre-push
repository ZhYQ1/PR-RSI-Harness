#!/bin/sh
# pr-harness pre-push hook: review the diff you are about to push.
#
# Install (Git Bash / Linux / macOS):
#   cp scripts/pre-push .git/hooks/pre-push
# Install (PowerShell):
#   Copy-Item scripts/pre-push .git/hooks/pre-push
#
# Optional environment variables:
#   PR_HARNESS_DB       SQLite path or postgresql:// URL (default: data/harness.db)
#   PR_HARNESS_REPO     owner/repo slug (default: parsed from the origin remote)
#   PR_HARNESS_PR       PR number stored as task metadata (default: 0)
#   PR_HARNESS_PYTHON   Python interpreter used when the pr-harness entry point is absent
#   PR_HARNESS_BLOCK=1  block the push when a harness run fails (default: warn only)
set -u

ZERO=0000000000000000000000000000000000000000
DB=${PR_HARNESS_DB:-data/harness.db}
PR_NUMBER=${PR_HARNESS_PR:-0}

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

if [ -n "${PR_HARNESS_REPO:-}" ]; then
  REPO=$PR_HARNESS_REPO
else
  REPO=$(git config --get remote.origin.url 2>/dev/null | sed -E 's#.*github.com[:/]##; s#\.git$##')
fi
REPO=${REPO:-local/$(basename "$ROOT")}

PYTHON_BIN=${PR_HARNESS_PYTHON:-}
if [ -z "$PYTHON_BIN" ]; then
  for candidate in python python3 py; do
    if command -v "$candidate" >/dev/null 2>&1; then
      PYTHON_BIN=$candidate
      break
    fi
  done
fi

run_harness() {
  if command -v pr-harness >/dev/null 2>&1; then
    pr-harness "$@"
    return
  fi
  if [ -z "$PYTHON_BIN" ]; then
    echo "pr-harness: no Python interpreter found; set PR_HARNESS_PYTHON" >&2
    return 127
  fi
  "$PYTHON_BIN" -m src.cli "$@"
}

# Keep the temporary diff inside the repository so that both the shell and a
# native Windows Python interpreter resolve the same path.
TMP_DIR=.git/pr-harness
mkdir -p "$TMP_DIR" || exit 1

CR=$(printf '\r')
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  # Tolerate CRLF input (e.g. when the hook is fed from PowerShell).
  local_ref=${local_ref%"$CR"}
  local_sha=${local_sha%"$CR"}
  remote_ref=${remote_ref%"$CR"}
  remote_sha=${remote_sha%"$CR"}
  # Skip branch deletions.
  [ "$local_sha" = "$ZERO" ] && continue
  branch=${local_ref#refs/heads/}

  if [ "$remote_sha" != "$ZERO" ]; then
    base=$remote_sha
  else
    # New branch: compare against the remote default branch when known.
    base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
    if [ -z "$base" ]; then
      echo "pr-harness: new branch '$branch' and origin/HEAD is unknown; skipping" >&2
      continue
    fi
  fi

  diff_file="$TMP_DIR/review-$$.diff"
  if ! git diff "$base...$local_sha" > "$diff_file"; then
    echo "pr-harness: cannot diff $base...$local_sha; skipping '$branch'" >&2
    rm -f "$diff_file"
    continue
  fi
  if [ ! -s "$diff_file" ]; then
    echo "pr-harness: no changes on '$branch'; skipping"
    rm -f "$diff_file"
    continue
  fi

  echo "pr-harness: reviewing '$branch' ($base...$local_sha)"
  if ! run_harness --db "$DB" submit --repo "$REPO" --pr "$PR_NUMBER" --branch "$branch" --diff-file "$diff_file"; then
    echo "pr-harness: review failed for '$branch'" >&2
    status=1
  fi
  rm -f "$diff_file"
done

if [ "$status" -ne 0 ] && [ "${PR_HARNESS_BLOCK:-0}" = "1" ]; then
  echo "pr-harness: push blocked (PR_HARNESS_BLOCK=1)" >&2
  exit 1
fi
exit 0
